# /etc/systemd/system/oracle-xe.service
# Levanta el contenedor de Oracle como servicio de systemd.
[Unit]
Description=Oracle Database 21c XE (Docker)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oracle-xe
ExecStart=/usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
